+    set_env("GGML_CUDA_MOE_CACHE_BUDGET_MB", "8");
+    set_env("GGML_CUDA_MOE_CACHE_NDEV", "2");
+    set_env("GGML_CUDA_MOE_CACHE_SPLIT_EXPERTS", "1");
+    set_env("GGML_CUDA_MOE_CACHE_STATS", "1");
+    capture.clear();
+
+    void * backends[] = { cuda, second_cuda, cpu };
+    void * session = ggml_moe_cache.session_create(backends, 3, nullptr);
+    if (!session) {
+        fprintf(stderr, "cache-same-layer-split-collect: failed to create session\n");
+        ggml_backend_free(second_cuda);
+        return false;
+    }
+
+    const size_t expert_size =
+        ggml_nbytes(up_weights) / up_weights->ne[2];
+    const ggml_moe_cache_tensor_desc up = {
+        up_weights->name, up_weights->data, expert_size,
+        up_weights->ne[0], up_weights->ne[1], up_weights->ne[2],
+        (int32_t)up_weights->type,
+    };
+    const ggml_moe_cache_tensor_desc gate = {
+        gate_weights->name, gate_weights->data, expert_size,
+        gate_weights->ne[0], gate_weights->ne[1], gate_weights->ne[2],
+        (int32_t)gate_weights->type,
+    };
+    const float * act_rows[2] = {
+        (const float *)activations->data,
+        (const float *)activations->data,
+    };
+
+    ggml_moe_cache.session_enter(session);
+    bool ready = false;
+    for (int step = 0; step < 80 && !ready; step++) {
+        ready = direct_begin_ready(
+                    up_weights->name, up_weights->data, expert_size,
+                    up_weights->ne[0], up_weights->ne[1], up_weights->type,
+                    up_weights->ne[2]) &&
+            direct_begin_ready(
+                    gate_weights->name, gate_weights->data, expert_size,
+                    gate_weights->ne[0], gate_weights->ne[1],
+                    gate_weights->type, gate_weights->ne[2]);
+    }
+    ready = ready &&
+        wait_for_direct_resident(up_weights, 0) &&
+        wait_for_direct_resident(up_weights, 1) &&
+        wait_for_direct_resident(gate_weights, 0) &&
+        wait_for_direct_resident(gate_weights, 1);
+
+    bool collected_ok = false;
+    if (ready) {
+        const int32_t experts[2] = { 0, 1 };
+        uint64_t hit_mask = 0;
+        void * node = ggml_moe_cache.fused_begin(
+                &up, &gate, GGML_GLU_OP_SWIGLU,
+                -std::numeric_limits<float>::infinity(),
+                std::numeric_limits<float>::infinity(),
+                -std::numeric_limits<float>::infinity(),
+                std::numeric_limits<float>::infinity(),
+                experts, 2, 1, act_rows, &hit_mask);
+        if (node && hit_mask == UINT64_C(3)) {
+            float output[2 * n_out];
+            float * rows[2] = { output, output + n_out };
+            collected_ok =
+                ggml_moe_cache.collect(node, 2, rows, n_out) == 1;
+            ggml_moe_cache.end(node);
+            if (collected_ok) {
+                std::vector<float> actual(output, output + 2 * n_out);
+                collected_ok = compare_output(fused_reference, actual, 5e-4);
+            }
+        } else if (node) {
+            ggml_moe_cache.end(node);
+        }
+    }
+    ggml_moe_cache.session_leave(session);
+    ggml_moe_cache.session_destroy(session);
+    ggml_backend_free(second_cuda);
+
+    const std::string log = capture.get();
+    const bool split_announced = log.find("split-experts=on") != std::string::npos;
+    const bool both_gpus =
+        log.find("CUDA0 ") != std::string::npos &&
+        log.find("CUDA1 ") != std::string::npos;
+    const bool prefetch =
+        has_positive_field(log, "download-prefetch=");
+    const bool ok = ready && collected_ok && split_announced &&
+        both_gpus && prefetch;
+    if (!ok) {
+        fprintf(stderr,
+                "cache-same-layer-split-collect: collect path failed ready=%d collected=%d\n%s",
+                (int)ready, (int)collected_ok, log.c_str());
+    }
+    printf("cache-same-layer-split-collect: %s\n", ok ? "OK" : "FAIL");
+    return ok;
+}
