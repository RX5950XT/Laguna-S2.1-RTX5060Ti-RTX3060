From d439a4e89cd49421827dabecd67cb1d6723f3cea Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Fri, 14 Aug 2026 13:53:10 +0800
Subject: [PATCH] feat: overlap MoE collect and fuse down MMV on the same
 stream

---
 ggml/src/ggml-backend-moe-cache.h |  11 +
 ggml/src/ggml-cpu/ggml-cpu.c      |  73 +++++-
 ggml/src/ggml-cuda/moe-cache.cu   | 388 +++++++++++++++++++++++++-----
 tests/test-moe-cache.cpp          | 263 ++++++++++++++++++++
 tools/llama-bench/CMakeLists.txt  |   5 +
 tools/llama-bench/llama-bench.cpp |  45 +++-
 6 files changed, 713 insertions(+), 72 deletions(-)

diff --git a/ggml/src/ggml-backend-moe-cache.h b/ggml/src/ggml-backend-moe-cache.h
index cf37588d..40edbb93 100644
--- a/ggml/src/ggml-backend-moe-cache.h
+++ b/ggml/src/ggml-backend-moe-cache.h
@@ -95,6 +95,17 @@ struct ggml_moe_cache_api {
                           const int32_t * ids, int n_rows, int64_t n_tokens,
                           const float * const * act_rows, uint64_t * hit_mask);
 
+    // Same as fused_begin, then immediately MMV `down` from the on-device GLU output.
+    // down may be NULL. Hits require up, gate, and down to be resident on the same lane.
+    // collect writes down->n_out rows instead of the GLU width.
+    void * (*fused_begin_ex)(const struct ggml_moe_cache_tensor_desc * up,
+                             const struct ggml_moe_cache_tensor_desc * gate,
+                             const struct ggml_moe_cache_tensor_desc * down,
+                             int glu_op, float up_min, float up_max,
+                             float gate_min, float gate_max,
+                             const int32_t * ids, int n_rows, int64_t n_tokens,
+                             const float * const * act_rows, uint64_t * hit_mask);
+
     // Host buffer mutation or teardown notification. Sessions cancel or finish any fill that still reads the supplied range before this call returns.
     void (*invalidate)(const void * base, size_t size);
 };
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 27f58a17..c37acde1 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1825,6 +1825,7 @@ struct moe_cache_fused_state {
     uint64_t hit_mask;
     int n_hits;
     int collect_ok;
+    int fused_down;
     int32_t ids[MOE_CACHE_MAX_TOPK];
     const float * acts[MOE_CACHE_MAX_TOPK];
     float * rows[MOE_CACHE_MAX_TOPK];
@@ -3166,6 +3167,7 @@ struct ggml_moe_cache_fusion {
     struct ggml_tensor * up;
     struct ggml_tensor * gate;
     struct ggml_tensor * glu;
+    struct ggml_tensor * down;
     float up_min;
     float up_max;
     float gate_min;
@@ -3294,6 +3296,25 @@ static bool ggml_moe_cache_can_fuse(
         up_weight->ne[2] <= 0) {
         return false;
     }
+
+    const int glu_index = node_n + fusion->skipped;
+    if (glu_index + 1 < cgraph->n_nodes) {
+        struct ggml_tensor * candidate = cgraph->nodes[glu_index + 1];
+        if (candidate && candidate->op == GGML_OP_MUL_MAT_ID &&
+            candidate->src[0] && candidate->src[1] == fusion->glu &&
+            candidate->src[2] == ids &&
+            ggml_moe_cache_weight_is_eligible(candidate->src[0]) &&
+            candidate->type == GGML_TYPE_F32 &&
+            ggml_is_contiguous_1(candidate) &&
+            candidate->src[0]->ne[0] == fusion->glu->ne[0] &&
+            candidate->src[0]->ne[1] == up_weight->ne[0] &&
+            candidate->src[0]->ne[2] == up_weight->ne[2] &&
+            candidate->ne[0] == candidate->src[0]->ne[1] &&
+            candidate->ne[1] == ids->ne[0] &&
+            candidate->ne[2] == ids->ne[1]) {
+            fusion->down = candidate;
+        }
+    }
     return true;
 }
 
@@ -3394,17 +3415,39 @@ static int ggml_cpu_try_fuse_moe_cache(
                 state->acts[row] = (const float *)((const char *)acts->data + token*acts->nb[2] + (id % acts->ne[1])*acts->nb[1]);
             }
         }
-        state->node = ggml_moe_cache.fused_begin(
-                &up_desc, &gate_desc, (int)GGML_GLU_OP_SWIGLU,
-                fusion.up_min, fusion.up_max,
-                fusion.gate_min, fusion.gate_max,
-                state->ids, n_rows, n_tokens,
-                state->acts, &state->hit_mask);
+        if (fusion.down && ggml_moe_cache.fused_begin_ex) {
+            struct ggml_moe_cache_tensor_desc down_desc = {
+                fusion.down->src[0]->name,
+                fusion.down->src[0]->data,
+                fusion.down->src[0]->nb[2],
+                fusion.down->src[0]->ne[0],
+                fusion.down->src[0]->ne[1],
+                fusion.down->src[0]->ne[2],
+                (int32_t)fusion.down->src[0]->type,
+            };
+            state->node = ggml_moe_cache.fused_begin_ex(
+                    &up_desc, &gate_desc, &down_desc,
+                    (int)GGML_GLU_OP_SWIGLU,
+                    fusion.up_min, fusion.up_max,
+                    fusion.gate_min, fusion.gate_max,
+                    state->ids, n_rows, n_tokens,
+                    state->acts, &state->hit_mask);
+            state->fused_down = state->node != NULL;
+        }
+        if (!state->node) {
+            state->node = ggml_moe_cache.fused_begin(
+                    &up_desc, &gate_desc, (int)GGML_GLU_OP_SWIGLU,
+                    fusion.up_min, fusion.up_max,
+                    fusion.gate_min, fusion.gate_max,
+                    state->ids, n_rows, n_tokens,
+                    state->acts, &state->hit_mask);
+        }
         if (state->node) {
+            struct ggml_tensor * dst = state->fused_down ? fusion.down : glu;
             for (int row = 0; row < n_rows; row++) {
                 if (state->hit_mask & (UINT64_C(1) << row)) {
                     state->rows[state->n_hits++] =
-                        (float *)((char *)glu->data + row*glu->nb[1]);
+                        (float *)((char *)dst->data + row*dst->nb[1]);
                 }
             }
         }
@@ -3435,9 +3478,16 @@ static int ggml_cpu_try_fuse_moe_cache(
             params, gate, up, glu, miss_mask, true,
             fusion.clamped, fusion.up_min, fusion.up_max,
             fusion.gate_min, fusion.gate_max);
+    if (state->fused_down && fusion.down) {
+        ggml_barrier(params->threadpool);
+        ggml_compute_forward_mul_mat_id_impl(
+                &sub_params, fusion.down, miss_mask, true, false);
+    }
     if (params->ith == 0) {
+        const int64_t collect_n_out = state->fused_down && fusion.down
+            ? fusion.down->ne[0] : glu->ne[0];
         state->collect_ok = ggml_moe_cache.collect(
-                state->node, state->n_hits, state->rows, glu->ne[0]);
+                state->node, state->n_hits, state->rows, collect_n_out);
         ggml_moe_cache.end(state->node);
         state->node = NULL;
     }
@@ -3454,9 +3504,14 @@ static int ggml_cpu_try_fuse_moe_cache(
                 params, gate, up, glu, state->hit_mask, false,
                 fusion.clamped, fusion.up_min, fusion.up_max,
                 fusion.gate_min, fusion.gate_max);
+        if (state->fused_down && fusion.down) {
+            ggml_barrier(params->threadpool);
+            ggml_compute_forward_mul_mat_id_impl(
+                    &sub_params, fusion.down, state->hit_mask, true, false);
+        }
     }
 
-    return fusion.skipped;
+    return fusion.skipped + (state->fused_down ? 1 : 0);
 }
 
