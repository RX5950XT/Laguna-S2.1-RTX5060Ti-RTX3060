+static bool run_fused_down_collect(
+        ggml_backend_t cuda, ggml_backend_t cpu,
+        ggml_tensor * up_weights,
+        ggml_tensor * gate_weights,
+        ggml_tensor * activations,
+        log_capture & capture) {
+    if (!ggml_moe_cache.fused_begin_ex || !ggml_moe_cache.collect) {
+        fprintf(stderr, "cache-fused-down: fused_begin_ex missing\n");
+        return false;
+    }
+
+    ggml_init_params params = {
+        16 * ggml_tensor_overhead() + ggml_graph_overhead(),
+        nullptr,
+        true,
+    };
+    ggml_context * ctx = ggml_init(params);
+    if (!ctx) {
+        return false;
+    }
+    ggml_tensor * down_weights = ggml_new_tensor_3d(
+            ctx, GGML_TYPE_Q4_0, n_out, n_in, n_expert);
+    ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, 1);
+    ggml_set_name(down_weights, "blk.0.ffn_down_exps.weight");
+    ggml_backend_buffer_t buffer = ggml_backend_alloc_ctx_tensors(ctx, cpu);
+    if (!buffer || !down_weights->data) {
+        if (buffer) {
+            ggml_backend_buffer_free(buffer);
+        }
+        ggml_free(ctx);
+        return false;
+    }
+    ggml_backend_buffer_set_usage(buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::vector<float> down_f32(ggml_nelements(down_weights));
+    for (size_t index = 0; index < down_f32.size(); index++) {
+        down_f32[index] = 0.09f * std::sin((float)(index % 641) * 0.019f);
+    }
+    std::vector<uint8_t> down_q4(ggml_nbytes(down_weights));
+    if (ggml_quantize_chunk(
+                GGML_TYPE_Q4_0, down_f32.data(), down_q4.data(),
+                0, n_in * n_expert, n_out, nullptr) != down_q4.size()) {
+        ggml_backend_buffer_free(buffer);
+        ggml_free(ctx);
+        return false;
+    }
+    ggml_backend_tensor_set(down_weights, down_q4.data(), 0, down_q4.size());
+    const int32_t expert0 = 0;
+    ggml_backend_tensor_set(ids, &expert0, 0, sizeof(expert0));
+
+    configure_cache(nullptr);
+    capture.clear();
+    void * session = create_direct_session(cuda, cpu);
+    if (!session) {
+        ggml_backend_buffer_free(buffer);
+        ggml_free(ctx);
+        return false;
+    }
+
+    const size_t up_expert = ggml_nbytes(up_weights) / up_weights->ne[2];
+    const size_t down_expert = ggml_nbytes(down_weights) / down_weights->ne[2];
+    const ggml_moe_cache_tensor_desc up_desc = {
+        up_weights->name, up_weights->data, up_expert,
+        up_weights->ne[0], up_weights->ne[1], up_weights->ne[2],
+        (int32_t)up_weights->type,
+    };
+    const ggml_moe_cache_tensor_desc gate_desc = {
+        gate_weights->name, gate_weights->data, up_expert,
+        gate_weights->ne[0], gate_weights->ne[1], gate_weights->ne[2],
+        (int32_t)gate_weights->type,
+    };
+    const ggml_moe_cache_tensor_desc down_desc = {
+        down_weights->name, down_weights->data, down_expert,
+        down_weights->ne[0], down_weights->ne[1], down_weights->ne[2],
+        (int32_t)down_weights->type,
+    };
+    const float * act_rows[1] = { (const float *)activations->data };
+
+    ggml_moe_cache.session_enter(session);
+    bool ready = false;
+    for (int step = 0; step < 80 && !ready; step++) {
+        ready = direct_begin_ready(
+                    up_weights->name, up_weights->data, up_expert,
+                    up_weights->ne[0], up_weights->ne[1], up_weights->type,
+                    up_weights->ne[2]) &&
+            direct_begin_ready(
+                    down_weights->name, down_weights->data, down_expert,
+                    down_weights->ne[0], down_weights->ne[1],
+                    down_weights->type, down_weights->ne[2]);
+    }
+    ready = ready &&
+        wait_for_direct_resident(up_weights, 0) &&
+        wait_for_direct_resident(gate_weights, 0) &&
+        wait_for_direct_resident(down_weights, 0);
+
+    bool ok = false;
+    if (ready) {
+        uint64_t hit_mask = 0;
+        void * node = ggml_moe_cache.fused_begin_ex(
+                &up_desc, &gate_desc, &down_desc, GGML_GLU_OP_SWIGLU,
+                -std::numeric_limits<float>::infinity(),
+                std::numeric_limits<float>::infinity(),
+                -std::numeric_limits<float>::infinity(),
+                std::numeric_limits<float>::infinity(),
+                &expert0, 1, 1, act_rows, &hit_mask);
+        if (node && hit_mask == UINT64_C(1)) {
+            std::vector<float> actual(n_in, 0.0f);
+            float * rows[1] = { actual.data() };
+            ok = ggml_moe_cache.collect(node, 1, rows, n_in) == 1;
+            if (ok) {
+                bool finite = true;
+                bool nonzero = false;
+                for (float value : actual) {
+                    finite = finite && std::isfinite(value);
+                    nonzero = nonzero || value != 0.0f;
+                }
+                ok = finite && nonzero;
+            }
+            ggml_moe_cache.end(node);
+        } else if (node) {
+            ggml_moe_cache.end(node);
+        }
+    }
+    ggml_moe_cache.session_leave(session);
+    ggml_moe_cache.session_destroy(session);
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+
+    printf("cache-fused-down: %s\n", ok ? "OK" : "FAIL");
+    return ok;
+}
