+static bool moe_cache_enqueue_output_download(
+        moe_cache_device & device, int n_hits, int64_t n_out) {
+    const size_t bytes = (size_t)n_hits * (size_t)n_out * sizeof(float);
+    if (bytes == 0 || !device.h_out || !device.d_out ||
+        !device.compute_stream ||
+        bytes > device.h_out_cap || bytes > device.d_out_cap) {
+        return false;
+    }
+    return moe_cache_cuda_ok(
+            device,
+            cudaMemcpyAsync(
+                    device.h_out, device.d_out, bytes,
+                    cudaMemcpyDeviceToHost, device.compute_stream),
+            "output download", true);
+}
+
+static bool moe_cache_sync_compute(moe_cache_device & device) {
+    if (!device.compute_stream) {
+        return false;
+    }
+    return moe_cache_cuda_ok(
+            device, cudaStreamSynchronize(device.compute_stream),
+            "output synchronization", true);
+}
