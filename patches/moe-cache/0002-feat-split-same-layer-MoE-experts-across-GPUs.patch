+static bool run_same_layer_split(
+        ggml_backend_dev_t first_device,
+        ggml_backend_t cuda, ggml_backend_t cpu,
+        log_capture & capture) {
+    ggml_backend_dev_t second_device = find_other_cuda_device(first_device);
+    if (!second_device) {
+        printf("cache-same-layer-split: SKIP (one CUDA device)\n");
+        return true;
+    }
+    const long first_physical = cuda_physical_device(first_device);
+    if (first_physical >= 0 &&
+        first_physical == cuda_physical_device(second_device)) {
+        printf("cache-same-layer-split: SKIP (one physical CUDA device)\n");
+        return true;
+    }
+    ggml_backend_t second_cuda =
+        ggml_backend_dev_init(second_device, nullptr);
+    if (!second_cuda) {
+        fprintf(stderr,
+                "cache-same-layer-split: failed to initialize second device\n");
+        return false;
+    }
+
+    configure_cache(nullptr);
+    set_env("GGML_CUDA_MOE_CACHE_BUDGET_MB", "8");
+    set_env("GGML_CUDA_MOE_CACHE_NDEV", "2");
+    set_env("GGML_CUDA_MOE_CACHE_SPLIT_EXPERTS", "1");
+    set_env("GGML_CUDA_MOE_CACHE_STATS", "1");
+    capture.clear();
+
+    void * backends[] = { cuda, second_cuda, cpu };
+    void * session = ggml_moe_cache.session_create(backends, 3, nullptr);
+    if (!session) {
+        fprintf(stderr, "cache-same-layer-split: failed to create session\n");
+        ggml_backend_free(second_cuda);
+        return false;
+    }
+
+    constexpr int64_t split_n_in = 256;
+    constexpr int64_t split_n_out = 128;
+    constexpr int64_t split_n_expert = 64;
+    const size_t expert_size =
+        ggml_row_size(GGML_TYPE_Q4_0, split_n_in) * split_n_out;
+    std::vector<uint8_t> weights(expert_size * split_n_expert);
+    const char * name = "blk.11.ffn_up_exps.weight";
+
+    ggml_moe_cache.session_enter(session);
+    const bool pool_ready = wait_for_direct_pool(
+            name, weights.data(), expert_size,
+            split_n_in, split_n_out, GGML_TYPE_Q4_0, split_n_expert);
+    bool both_resident = pool_ready;
+    for (int32_t expert = 0; expert < 2 && both_resident; expert++) {
+        (void)direct_plan_one(
+                name, weights.data(), expert_size,
+                split_n_in, split_n_out, GGML_TYPE_Q4_0, split_n_expert, expert);
+        bool hit = false;
+        for (int attempt = 0; attempt < 200 && !hit; attempt++) {
+            hit = direct_plan_one(
+                    name, weights.data(), expert_size,
+                    split_n_in, split_n_out, GGML_TYPE_Q4_0,
+                    split_n_expert, expert) == 1;
+            if (!hit) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+        }
+        both_resident = hit;
+    }
+    const int32_t experts[2] = { 0, 1 };
+    const int hits = both_resident
+        ? direct_plan_many(
+                name, weights.data(), expert_size,
+                split_n_in, split_n_out, GGML_TYPE_Q4_0,
+                split_n_expert, experts, 2)
+        : -1;
+    ggml_moe_cache.session_leave(session);
+    ggml_moe_cache.session_destroy(session);
+    ggml_backend_free(second_cuda);
+
+    const std::string log = capture.get();
+    const bool split_announced = log.find("split-experts=on") != std::string::npos;
+    const bool two_devices = log.find("devices=2") != std::string::npos;
+    const bool both_gpus =
+        log.find("CUDA0 ") != std::string::npos &&
+        log.find("CUDA1 ") != std::string::npos;
+    const bool ok = pool_ready && both_resident && hits == 2 &&
+        split_announced && two_devices && both_gpus;
+    if (!ok) {
+        fprintf(stderr, "cache-same-layer-split: unexpected routing\n%s",
+                log.c_str());
+    }
+    printf("cache-same-layer-split: %s\n", ok ? "OK" : "FAIL");
+    return ok;
+}
