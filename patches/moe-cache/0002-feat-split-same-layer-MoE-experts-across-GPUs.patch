+static int moe_cache_expert_lane(int32_t expert, int n_lanes) {
+    if (n_lanes <= 1) {
+        return 0;
+    }
+    return (int)((uint32_t)expert % (uint32_t)n_lanes);
+}
+
+static int32_t moe_cache_pack_slot(int lane, int slot) {
+    return (int32_t)(((uint32_t)lane << moe_cache_slot_lane_shift) |
+                     ((uint32_t)slot & (uint32_t)moe_cache_slot_mask));
+}
+
+static int moe_cache_unpack_lane(int32_t packed) {
+    return (int)((uint32_t)packed >> moe_cache_slot_lane_shift);
+}
+
+static int moe_cache_unpack_slot(int32_t packed) {
+    return (int)((uint32_t)packed & (uint32_t)moe_cache_slot_mask);
+}
+
+static int64_t moe_cache_lane_entries(int64_t n_expert, int lane, int n_lanes) {
+    if (n_lanes <= 1 || n_expert <= 0) {
+        return n_expert;
+    }
+    int64_t count = 0;
+    for (int64_t expert = 0; expert < n_expert; expert++) {
+        if (moe_cache_expert_lane((int32_t)expert, n_lanes) == lane) {
+            count++;
+        }
+    }
+    return count;
+}
+
+static void moe_cache_node_set_primary(moe_cache_node & node) {
+    if (node.n_lanes <= 0) {
+        return;
+    }
+    node.device = node.devices[0];
+    node.pool = node.pools[0];
+    node.pool_index = node.pool_indices[0];
+}
+
