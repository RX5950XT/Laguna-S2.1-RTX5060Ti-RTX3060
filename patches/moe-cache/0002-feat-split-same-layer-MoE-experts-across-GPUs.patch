+                node.get(), up->type, up->n_in, up->n_out, hits,
+                up_slots, hit_acts, pool, gate_slots, glu_op,
+                up_min, up_max, gate_min, gate_max) != 0;
+        if (dispatched) {
+            node->lane_dispatched[0] = true;
+            node->lane_n[0] = hits;
+            for (int index = 0; index < hits; index++) {
+                node->lane_dst[0][index] = index;
+            }
+        }
+    } else if (hits > 0) {
+        int32_t lane_up[moe_cache_max_lanes][moe_cache_node_rows_max];
+        int32_t lane_gate[moe_cache_max_lanes][moe_cache_node_rows_max];
+        const float * lane_acts[moe_cache_max_lanes][moe_cache_node_rows_max];
+        for (int lane = 0; lane < fused_n_lanes; lane++) {
+            node->lane_n[lane] = 0;
+        }
+        for (int index = 0; index < hits; index++) {
+            const int lane = hit_lanes[index];
+            const int local = node->lane_n[lane];
+            lane_up[lane][local] = up_slots[index];
+            lane_gate[lane][local] = gate_slots[index];
+            lane_acts[lane][local] = hit_acts[index];
+            node->lane_dst[lane][local] = index;
+            node->lane_n[lane]++;
+        }
+        dispatched = true;
+        for (int lane = 0; lane < fused_n_lanes; lane++) {
+            if (node->lane_n[lane] <= 0) {
+                continue;
+            }
+            if (!moe_cache_dispatch_internal(
+                    node.get(), up->type, up->n_in, up->n_out, node->lane_n[lane],
+                    lane_up[lane], lane_acts[lane], fused_pools[lane],
+                    lane_gate[lane], glu_op, up_min, up_max, gate_min, gate_max,
+                    fused_devices[lane], fused_pools[lane])) {
+                dispatched = false;
+                break;
+            }
+            node->lane_dispatched[lane] = true;
+        }
+        node->dispatched = dispatched;
+    }
+    if (!dispatched) {
         moe_cache_end(node.release());
         return nullptr;
     }
