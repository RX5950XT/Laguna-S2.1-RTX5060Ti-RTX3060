diff --git a/crates/engine/src/kv_ring.rs b/crates/engine/src/kv_ring.rs
new file mode 100644
index 0000000..0dd595e
--- /dev/null
+++ b/crates/engine/src/kv_ring.rs
@@ -0,0 +1,125 @@
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct GqaKvCachePlan {
+    pub(crate) capacity: u32,
+    pub(crate) window: u32,
+    pub(crate) context: u32,
+}
+
+impl GqaKvCachePlan {
+    pub(crate) fn is_ring(self) -> bool {
+        self.capacity < self.context
+    }
+
+    pub(crate) fn accepts_batch(self, n_tok: u32) -> bool {
+        if n_tok == 0 {
+            return false;
+        }
+        !self.is_ring() || n_tok <= self.capacity.saturating_sub(self.window)
+    }
+}
+
+/// Plan a causal GQA cache. Sliding layers reserve one full attention window
+/// plus `max_batch` scratch rows because Pulsar appends a whole prefill batch
+/// before evaluating its causal attention. The slack prevents future rows in
+/// that batch from overwriting keys still visible to its first query row.
+pub(crate) fn gqa_kv_cache_plan(
+    context: u32,
+    window: u32,
+    max_batch: u32,
+) -> Result<GqaKvCachePlan, &'static str> {
+    if context == 0 {
+        return Err("KV context must be non-zero");
+    }
+    if max_batch == 0 {
+        return Err("KV max_batch must be non-zero");
+    }
+    let requested = if window == 0 {
+        context as u64
+    } else {
+        window as u64 + max_batch as u64
+    };
+    let capacity = (context as u64).min(requested) as u32;
+    Ok(GqaKvCachePlan {
+        capacity,
+        window,
+        context,
+    })
+}
+
+/// Bytes in one `(kv_head, position)` cache row for Pulsar's GQA codecs.
+pub(crate) fn gqa_kv_row_bytes(head_dim: u32, kvq: u32) -> Result<usize, &'static str> {
+    if head_dim == 0 {
+        return Err("KV head_dim must be non-zero");
+    }
+    let hd = head_dim as usize;
+    match kvq {
+        0 => hd.checked_mul(4).ok_or("KV row size overflow"),
+        1 | 3 => hd.checked_add(4).ok_or("KV row size overflow"),
+        2 => hd.checked_mul(2).ok_or("KV row size overflow"),
+        4 if head_dim.is_multiple_of(32) => (hd / 32).checked_mul(34).ok_or("KV row size overflow"),
+        5 if head_dim.is_multiple_of(32) => (hd / 32).checked_mul(18).ok_or("KV row size overflow"),
+        4 | 5 => Err("block KV codec requires head_dim divisible by 32"),
+        _ => Err("unknown KV codec"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{gqa_kv_cache_plan, gqa_kv_row_bytes};
+
+    #[test]
+    fn laguna_256k_swa_uses_window_plus_batch_slack() {
+        let plan = gqa_kv_cache_plan(262_144, 512, 256).unwrap();
+
+        assert_eq!(plan.capacity, 768);
+        assert!(plan.is_ring());
+    }
+
+    #[test]
+    fn full_attention_keeps_the_complete_context() {
+        let plan = gqa_kv_cache_plan(262_144, 0, 256).unwrap();
+
+        assert_eq!(plan.capacity, 262_144);
+        assert!(!plan.is_ring());
+    }
+
+    #[test]
+    fn short_context_does_not_wrap_or_overallocate() {
+        let plan = gqa_kv_cache_plan(256, 512, 256).unwrap();
+
+        assert_eq!(plan.capacity, 256);
+        assert!(!plan.is_ring());
+    }
+
+    #[test]
+    fn ring_capacity_is_safe_for_the_largest_prefill_batch() {
+        let plan = gqa_kv_cache_plan(262_144, 512, 256).unwrap();
+
+        assert!(plan.accepts_batch(256));
+        assert!(!plan.accepts_batch(257));
+    }
+
+    #[test]
+    fn every_gqa_kv_codec_has_the_expected_row_stride() {
+        let strides = (0..=5)
+            .map(|kvq| gqa_kv_row_bytes(128, kvq).unwrap())
+            .collect::<Vec<_>>();
+
+        assert_eq!(strides, vec![512, 132, 256, 132, 136, 72]);
+    }
+
+    #[test]
+    fn block_codecs_reject_partial_blocks() {
+        assert!(gqa_kv_row_bytes(96, 4).is_ok());
+        assert!(gqa_kv_row_bytes(100, 4).is_err());
+        assert!(gqa_kv_row_bytes(100, 5).is_err());
+    }
+
+    #[test]
+    fn invalid_zero_dimensions_are_rejected() {
+        assert!(gqa_kv_cache_plan(0, 512, 256).is_err());
+        assert!(gqa_kv_cache_plan(262_144, 512, 0).is_err());
+        assert!(gqa_kv_row_bytes(0, 0).is_err());
+        assert!(gqa_kv_row_bytes(128, 6).is_err());
+    }
+}
