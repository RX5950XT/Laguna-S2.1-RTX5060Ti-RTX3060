+static bool gqa_attention_span_valid(
+        uint32_t cap, uint32_t pos0, uint32_t n_tok, uint32_t window) {
+    if (cap == 0 || n_tok == 0) return false;
+    const uint64_t logical_end = (uint64_t)pos0 + n_tok;
+    if (window == 0u) return logical_end <= cap;
+    if (logical_end <= cap) return true;
+    if (window > cap) return false;
+    return n_tok <= cap - window;
+}
