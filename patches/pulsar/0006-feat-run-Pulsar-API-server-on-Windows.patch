     }
+    cmd
+}
+
+/// Replace this process on Unix so the listening socket is released atomically.
+#[cfg(target_os = "linux")]
+fn reexec(newmodel: &std::path::Path, cpu_lane: bool, new_ctx: Option<u32>, mtp: bool, kv: Option<&str>) -> std::io::Error {
+    use std::os::unix::process::CommandExt;
+    let mut cmd = reexec_command(newmodel, cpu_lane, new_ctx, mtp, kv);
     cmd.exec()
 }
 
+/// Windows has no exec(2). Start a delayed replacement, then terminate the
+/// current process so the child can bind the same port without a race.
+#[cfg(target_os = "windows")]
+fn reexec(newmodel: &std::path::Path, cpu_lane: bool, new_ctx: Option<u32>, mtp: bool, kv: Option<&str>) -> std::io::Error {
+    let mut cmd = reexec_command(newmodel, cpu_lane, new_ctx, mtp, kv);
+    cmd.env("PULSAR_REEXEC_DELAY_MS", "500");
+    match cmd.spawn() {
+        Ok(_) => std::process::exit(0),
+        Err(error) => error,
+    }
+}
