     let mut i = 1;
@@ -1193,9 +1203,29 @@ fn reexec(newmodel: &std::path::Path, cpu_lane: bool, new_ctx: Option<u32>, mtp:
         Some(v) => { cmd.env("PULSAR_KV", v); }
