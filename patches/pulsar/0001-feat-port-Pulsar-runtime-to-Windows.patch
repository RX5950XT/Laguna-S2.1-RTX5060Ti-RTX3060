+        let path = temp_dir.join(format!("stream-{}.bin", std::process::id()));
+        let bytes = (0..12_288).map(|index| (index % 251) as u8).collect::<Vec<_>>();
+        std::fs::write(&path, &bytes).unwrap();
+
+        let reads = [Read { offset: 137, len: 1_003 }, Read { offset: 5_017, len: 733 }];
+        let mut fetcher = fetch::Fetcher::open(&path, 4).unwrap();
+        let slabs = fetcher.fetch(&reads).unwrap();
+
+        assert_eq!(slabs[0].payload(), &bytes[137..1_140]);
+        assert_eq!(slabs[1].payload(), &bytes[5_017..5_750]);
+        drop(fetcher);
+        std::fs::remove_file(path).unwrap();
+        let _ = std::fs::remove_dir(temp_dir);
+    }
