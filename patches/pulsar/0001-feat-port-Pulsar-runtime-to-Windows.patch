+#[cfg(target_os = "windows")]
+pub mod fetch {
+    //! Synchronous Windows fetcher with the same owned-slab contract as
+    //! the Linux `io_uring` implementation.  Expert buffers can still be
+    //! CUDA-pinned through `BufAlloc`, preserving full-speed H2D copies.
+
+    use super::uring::Aligned;
+    use super::Read;
+    use std::os::windows::fs::FileExt;
+
+    const ALIGN: u64 = 4096;
+
+    pub struct Slab {
+        buf: Aligned,
+        payload_off: usize,
+        payload_len: usize,
+    }
+
+    impl Slab {
+        pub fn payload(&self) -> &[u8] {
+            unsafe {
+                std::slice::from_raw_parts(self.buf.ptr().add(self.payload_off), self.payload_len)
+            }
+        }
+
+        pub fn bytes(&self) -> usize {
+            self.buf.cap()
+        }
+    }
+
+    pub struct Fetcher {
+        files: Vec<(u64, std::fs::File)>,
+        _qd: usize,
+        buf_alloc: Option<super::uring::BufAlloc>,
+    }
+
+    impl Fetcher {
+        pub fn open(path: &std::path::Path, qd: usize) -> std::io::Result<Fetcher> {
+            Self::open_with(path, qd, None)
+        }
+
+        pub fn open_with(
+            path: &std::path::Path,
+            qd: usize,
+            buf_alloc: Option<super::uring::BufAlloc>,
+        ) -> std::io::Result<Fetcher> {
+            Self::open_split(std::slice::from_ref(&(0, path.to_path_buf())), qd, buf_alloc)
+        }
+
+        pub fn open_split(
+            shards: &[(u64, std::path::PathBuf)],
+            qd: usize,
+            buf_alloc: Option<super::uring::BufAlloc>,
+        ) -> std::io::Result<Fetcher> {
+            let mut files = Vec::with_capacity(shards.len());
+            for (base, path) in shards {
+                files.push((*base, std::fs::File::open(path)?));
+            }
+            Ok(Fetcher { files, _qd: qd, buf_alloc })
+        }
+
+        fn route(&self, offset: u64) -> (&std::fs::File, u64) {
+            let index = match self.files.binary_search_by(|(base, _)| base.cmp(&offset)) {
+                Ok(index) => index,
+                Err(index) => index.saturating_sub(1),
+            };
+            (&self.files[index].1, offset - self.files[index].0)
+        }
+
+        fn read_exact_at(
+            file: &std::fs::File,
+            mut buf: &mut [u8],
+            mut offset: u64,
+        ) -> std::io::Result<()> {
+            while !buf.is_empty() {
+                let read = file.seek_read(buf, offset)?;
+                if read == 0 {
+                    return Err(std::io::Error::from(std::io::ErrorKind::UnexpectedEof));
+                }
+                offset += read as u64;
+                buf = &mut buf[read..];
+            }
+            Ok(())
+        }
+
+        pub fn fetch(&mut self, reads: &[Read]) -> std::io::Result<Vec<Slab>> {
+            let mut output = Vec::with_capacity(reads.len());
+            self.fetch_each(reads, |_, slab| {
+                output.push(slab);
+                Ok(())
+            })?;
+            Ok(output)
+        }
+
+        pub fn fetch_each(
+            &mut self,
+            reads: &[Read],
+            mut on_slab: impl FnMut(usize, Slab) -> std::io::Result<()>,
+        ) -> std::io::Result<()> {
+            for (index, read) in reads.iter().enumerate() {
+                let (file, local) = self.route(read.offset);
+                let aligned_off = local & !(ALIGN - 1);
+                let payload_off = (local - aligned_off) as usize;
+                let disk_len = (payload_off as u64 + read.len).next_multiple_of(ALIGN);
+                let buffer = Aligned::new_with(
+                    disk_len as usize + 256,
+                    ALIGN as usize,
+                    self.buf_alloc,
+                )
+                .ok_or_else(|| std::io::Error::from(std::io::ErrorKind::OutOfMemory))?;
+                let target = unsafe {
+                    std::slice::from_raw_parts_mut(buffer.ptr(), disk_len as usize)
+                };
+                Self::read_exact_at(file, target, aligned_off)?;
+                on_slab(index, Slab { buf: buffer, payload_off, payload_len: read.len as usize })?;
+            }
+            Ok(())
+        }
+    }
+}
