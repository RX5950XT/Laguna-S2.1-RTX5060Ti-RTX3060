-use quant::cpu_dot::{quantize_row_q8_k, vec_dot_iq2_xxs_q8_k, IQ2_XXS_BLOCK_BYTES, QK_K};
+use quant::cpu_dot::{
+    quantize_row_q8_k, vec_dot_iq2_xxs_q8_k, vec_dot_q4_k_q8_k, IQ2_XXS_BLOCK_BYTES,
+    Q4_K_BLOCK_BYTES, QK_K,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Format {
+    Iq2Xxs,
+    Q4K,
+}
+
+impl Format {
+    fn parse(value: Option<String>) -> Self {
+        match value.as_deref() {
+            Some("q4_k") | Some("q4") => Self::Q4K,
+            _ => Self::Iq2Xxs,
+        }
+    }
+
+    fn block_bytes(self) -> usize {
+        match self {
+            Self::Iq2Xxs => IQ2_XXS_BLOCK_BYTES,
+            Self::Q4K => Q4_K_BLOCK_BYTES,
+        }
+    }
+
+    fn dot(self, row: &[u8], xq: &quant::cpu_dot::Q8KRow, n_cols: usize) -> f32 {
+        match self {
+            Self::Iq2Xxs => vec_dot_iq2_xxs_q8_k(row, xq, n_cols),
+            Self::Q4K => vec_dot_q4_k_q8_k(row, xq, n_cols),
+        }
+    }
+
+    fn sanitize_row(self, row: &mut [u8]) {
+        for block in row.chunks_exact_mut(self.block_bytes()) {
+            block[0..2].copy_from_slice(&0x3c00u16.to_le_bytes());
+            if self == Self::Q4K {
+                block[2..4].fill(0);
+            }
+        }
+    }
+}
 
