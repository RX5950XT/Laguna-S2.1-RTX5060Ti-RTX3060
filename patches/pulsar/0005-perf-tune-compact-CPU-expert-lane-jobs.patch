+            fn q4_matrix(rows: usize, cols: usize, seed: &mut u64) -> Vec<u8> {
+                let row_bytes = cols / 256 * quant::cpu_dot::Q4_K_BLOCK_BYTES;
+                let mut data = vec![0u8; rows * row_bytes];
+                for chunk in data.chunks_exact_mut(8) {
+                    *seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+                    chunk.copy_from_slice(&seed.to_le_bytes());
+                }
+                for row in data.chunks_exact_mut(row_bytes) {
+                    for block in row.chunks_exact_mut(quant::cpu_dot::Q4_K_BLOCK_BYTES) {
+                        block[..2].copy_from_slice(&0x3c00u16.to_le_bytes());
+                        block[2..4].fill(0);
+                    }
+                }
+                data
+            }
+
+            #[test]
+            fn lane_matches_serial_q4_k_expert() {
+                let (ne, nf) = (256usize, 256usize);
+                let (grb, drb) = (
+                    ne / 256 * quant::cpu_dot::Q4_K_BLOCK_BYTES,
+                    nf / 256 * quant::cpu_dot::Q4_K_BLOCK_BYTES,
+                );
+                let mut seed = 7u64;
+                let gate = q4_matrix(nf, ne, &mut seed);
+                let up = q4_matrix(nf, ne, &mut seed);
+                let down = q4_matrix(ne, nf, &mut seed);
+                let normed = (0..ne)
+                    .map(|i| ((i % 31) as f32 - 15.0) / 15.0)
+                    .collect::<Vec<_>>();
+                let weight = 0.375f32;
+                let pool = Pool::new(2);
+                let mut lane = Lane::new(
+                    kernels::QUANT_Q4_K, kernels::QUANT_Q4_K, grb, drb, ne, nf, 0,
+                );
+                lane.add(7, gate.as_ptr(), up.as_ptr(), down.as_ptr());
+                let jobs = lane.submit_a(&pool, &[7], 1, &normed, &[weight], 1);
+                pool.wait(jobs);
+                let actual = lane.finish(&pool, 1);
+
+                let xq = quant::cpu_dot::quantize_row_q8_k(&normed);
+                let mid = (0..nf)
+                    .map(|j| {
+                        let g = dot(kernels::QUANT_Q4_K, &gate[j * grb..(j + 1) * grb], &xq, ne);
+                        let u = dot(kernels::QUANT_Q4_K, &up[j * grb..(j + 1) * grb], &xq, ne);
+                        glu(g, u, 0) * weight
+                    })
+                    .collect::<Vec<_>>();
+                let midq = quant::cpu_dot::quantize_row_q8_k(&mid);
+                let expected = (0..ne)
+                    .map(|r| dot(kernels::QUANT_Q4_K, &down[r * drb..(r + 1) * drb], &midq, nf))
+                    .collect::<Vec<_>>();
+                assert_eq!(actual, expected);
+            }
