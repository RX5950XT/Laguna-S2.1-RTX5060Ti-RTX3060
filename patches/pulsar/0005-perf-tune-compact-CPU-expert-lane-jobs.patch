+            #[test]
+            #[ignore = "manual Ryzen/APEX compact microbenchmark"]
+            fn apex_compact_lane_benchmark() {
+                let read = |name: &str, default| {
+                    std::env::var(name).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+                };
+                let threads = read("PULSAR_CPU_BENCH_THREADS", 6usize);
+                let experts = read("PULSAR_CPU_BENCH_EXPERTS", 2usize);
+                let iterations = read("PULSAR_CPU_BENCH_ITERS", 20usize);
+                let (ne, nf) = (3072usize, 1024usize);
+                let (grb, drb) = (
+                    ne / 256 * quant::cpu_dot::Q4_K_BLOCK_BYTES,
+                    nf / 256 * quant::cpu_dot::Q4_K_BLOCK_BYTES,
+                );
+                let mut seed = 11u64;
+                let weights = (0..experts)
+                    .map(|_| (
+                        q4_matrix(nf, ne, &mut seed),
+                        q4_matrix(nf, ne, &mut seed),
+                        q4_matrix(ne, nf, &mut seed),
+                    ))
+                    .collect::<Vec<_>>();
+                let normed = (0..ne)
+                    .map(|i| ((i % 97) as f32 - 48.0) / 48.0)
+                    .collect::<Vec<_>>();
+                let selected = (0..experts as i32).collect::<Vec<_>>();
+                let router = vec![1.0 / experts as f32; experts];
+                let pool = Pool::new(threads);
+                let run = || {
+                    let mut lane = Lane::new(
+                        kernels::QUANT_Q4_K, kernels::QUANT_Q4_K, grb, drb, ne, nf, 0,
+                    );
+                    for (e, (gate, up, down)) in weights.iter().enumerate() {
+                        lane.add(e as i32, gate.as_ptr(), up.as_ptr(), down.as_ptr());
+                    }
+                    let jobs = lane.submit_a(&pool, &selected, experts, &normed, &router, 1);
+                    pool.wait(jobs);
+                    std::hint::black_box(lane.finish(&pool, 1));
+                };
+                for _ in 0..3 { run(); }
+                let start = std::time::Instant::now();
+                for _ in 0..iterations { run(); }
+                let elapsed = start.elapsed().as_secs_f64();
+                let bytes_per_expert = 2 * nf * grb + ne * drb;
+                eprintln!(
+                    "apex-lane: threads={threads} experts={experts} iterations={iterations} {:.3} ms/layer {:.2} GB/s",
+                    elapsed * 1e3 / iterations as f64,
+                    (bytes_per_expert * experts * iterations) as f64 / 1e9 / elapsed,
+                );
+            }
+        }
