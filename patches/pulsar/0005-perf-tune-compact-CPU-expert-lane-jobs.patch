+        fn stage_a_chunk_rows(rows: usize, active_experts: usize, threads: usize) -> usize {
+            let jobs_per_expert = threads.div_ceil(active_experts.max(1));
+            rows.div_ceil(jobs_per_expert).clamp(64, 256).min(rows)
+        }
