+    /// Native K-quant counterpart to upload_attn. Raw GGUF blocks stay
+    /// compact in VRAM and in the optional zero-copy host placement.
+    fn upload_kq_attn(
+        file: &VFile,
+        g: &Gguf,
+        name: &str,
+        vram_budget: &mut i64,
+    ) -> Result<KqW> {
+        let t = g.tensor(name).ok_or_else(|| meta_err(name))?;
+        let MatLoad::Kq { bytes, row_bytes, quant } = MatW::plan(t) else {
+            return Err(format!("{name}: unsupported native attention type {:?}", t.ty).into());
+        };
+        let mut raw = vec![0u8; bytes as usize];
+        file.read_exact_at(&mut raw, g.data_offset + t.offset)?;
+        let force_host = std::env::var("PULSAR_ATTN_HOST").ok().as_deref() == Some("1");
+        let use_vram = !force_host && *vram_budget >= bytes as i64;
+        let mut w = if use_vram {
+            *vram_budget -= bytes as i64;
+            DeviceBuf::alloc(bytes as usize)?
+        } else {
+            DeviceBuf::alloc_pinned(bytes as usize)?
+        };
+        w.write(0, &raw)?;
+        Ok(KqW { w, row_bytes, quant })
+    }
