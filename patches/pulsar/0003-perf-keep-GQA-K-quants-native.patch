+
+    fn matw(out: &mut DeviceBuf, w: &MatW, x: &DeviceBuf, xq: &DeviceBuf, in_dim: u32, out_dim: u32, n_tok: u32) -> Result {
+        match w {
+            MatW::Q8(w) => kernels::matmul_q8_0(out, w, x, in_dim, out_dim, n_tok)?,
+            MatW::Kq(w) => kernels::matmul_kq(out, &w.w, xq, in_dim, out_dim, n_tok, w.row_bytes, w.quant)?,
+        }
+        Ok(())
+    }
